{
  "manifest_version": 3,
  "name": "Classcastle",
  "version": "1.1.0",
  "description": "Classroom management tool for teachers to navigate student browsers",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://hduyofdbpspjcuwvackd.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": ["https://classcastle.org/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "classcastle@classcastle.org"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
