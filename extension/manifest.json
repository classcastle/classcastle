{
  "manifest_version": 3,
  "name": "Classcastle",
  "version": "1.1.0",
  "description": "Classroom management tool for teachers to navigate student browsers",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://hduyofdbpspjcuwvackd.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": ["https://classcastle.org/*"]
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "classcastle@classcastle.org",
      "data_collection_permissions": {
        "tabs": {
          "allowed": true,
          "required": true,
          "description": "Required to navigate student browsers to target URLs"
        },
        "storage": {
          "allowed": true,
          "required": true,
          "description": "Required to store room and student session data"
        },
        "alarms": {
          "allowed": true,
          "required": true,
          "description": "Required for periodic polling for room updates"
        }
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
